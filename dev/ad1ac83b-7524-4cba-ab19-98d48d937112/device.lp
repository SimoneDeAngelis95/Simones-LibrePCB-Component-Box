(librepcb_device ad1ac83b-7524-4cba-ab19-98d48d937112
 (name "Bypass Board Interface — 4 Solder Wires")
 (description "Four independent passive wire connections to an external bypass board, named from the fuzz circuit perspective: 1 FX_IN to external BI; 2 GND common; 3 FX_OUT to external BO; 4 9V_PROTECTED to external +9V for the LED branch. No internal connections or forced net names. Project documentation only: future J4 FX_IN to R1/C1 junction; GND to circuit ground; FX_OUT to Volume P2 wiper; 9V_PROTECTED to D1 cathode before R5. Audio jacks, 3PDT, LED and R14 4.7 kohm are external to the main PCB and are not part of this interface.")
 (keywords "external,bypass,board,interface,fuzz,wire,4-wire")
 (author "Simone De Angelis")
