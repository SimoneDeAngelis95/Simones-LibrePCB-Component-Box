(librepcb_component 1a829868-c212-40a6-a78c-6384d23cd7ec
 (name "3PDT Footswitch (External)")
 (description "Three mechanically linked changeover contacts for an external latching 3PDT footswitch. Schematic only: no footprint on the main PCB. Terminal labels follow columns A/B/C and rows 1/2/3; row 2 is common. Use with the separate four-wire bypass module connector. Physical terminal orientation must be checked on the actual switch.")
 (keywords "3pdt,footswitch,bypass,external,schematic,ON-ON")
